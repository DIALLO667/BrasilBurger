@{
    ViewData["Title"] = "Inscription";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <!-- Logo / Titre -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">🍔 Brasil Burger</h2>
                        <p class="text-muted">Créer votre compte</p>
                    </div>

                    <!-- Message Erreur -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                        </div>
                    }

                    <!-- Formulaire -->
                    <form method="post" asp-action="Register">
                        <div class="row">
                            <!-- Nom -->
                            <div class="col-md-6 mb-3">
                                <label for="nom" class="form-label">Nom *</label>
                                <input type="text" class="form-control" id="nom" name="nom" 
                                       placeholder="Diallo" required>
                            </div>

                            <!-- Prénom -->
                            <div class="col-md-6 mb-3">
                                <label for="prenom" class="form-label">Prénom *</label>
                                <input type="text" class="form-control" id="prenom" name="prenom" 
                                       placeholder="Amadou" required>
                            </div>
                        </div>

                        <!-- Téléphone -->
                        <div class="mb-3">
                            <label for="telephone" class="form-label">Téléphone *</label>
                            <input type="tel" class="form-control" id="telephone" name="telephone" 
                                   placeholder="+221 77 123 45 67" required>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label for="email" class="form-label">Email *</label>
                            <input type="email" class="form-control" id="email" name="email" 
                                   placeholder="votre@email.com" required>
                        </div>

                        <!-- Mot de passe -->
                        <div class="mb-3">
                            <label for="motDePasse" class="form-label">Mot de passe *</label>
                            <input type="password" class="form-control" id="motDePasse" name="motDePasse" 
                                   placeholder="Au moins 6 caractères" required>
                            <small class="text-muted">Minimum 6 caractères</small>
                        </div>

                        <!-- Confirmer mot de passe -->
                        <div class="mb-3">
                            <label for="confirmMotDePasse" class="form-label">Confirmer mot de passe *</label>
                            <input type="password" class="form-control" id="confirmMotDePasse" name="confirmMotDePasse" 
                                   placeholder="••••••••" required>
                        </div>

                        <!-- Conditions -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="conditions" required>
                            <label class="form-check-label" for="conditions">
                                J'accepte les conditions d'utilisation
                            </label>
                        </div>

                        <!-- Bouton Inscription -->
                        <button type="submit" class="btn btn-warning w-100 mb-3">
                            Créer mon compte
                        </button>

                        <!-- Lien Connexion -->
                        <div class="text-center">
                            <p class="text-muted mb-0">
                                Déjà un compte ? 
                                <a href="@Url.Action("Login", "Auth")" class="text-warning fw-bold">
                                    Se connecter
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@model BrasilBurger.ClientApp.Models.Burger

@{
    ViewData["Title"] = Model.Nom;
}

<div class="container mt-4">
    <!-- Bouton Retour -->
    <a href="@Url.Action("Index", "Burger")" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Retour
    </a>

    <div class="row">
        <!-- Image -->
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" class="img-fluid rounded shadow" alt="@Model.Nom">
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 400px;">
                    <span class="display-1">🍔</span>
                </div>
            }
        </div>

        <!-- Informations -->
        <div class="col-md-6">
            <h1 class="display-5 mb-3">@Model.Nom</h1>
            
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted lead">@Model.Description</p>
            }
            else
            {
                <p class="text-muted lead">Un burger classique avec steak de bœuf 100% frais, salade croquante, tomates juteuses, oignons, et notre sauce secrète maison.</p>
            }

            <!-- Prix -->
            <div class="my-4">
                <h2 class="text-warning">@Model.Prix.ToString("N0") FCFA</h2>
            </div>

            <!-- Compléments (optionnel) -->
            <div class="mb-4">
                <h5>Compléments (optionnel)</h5>
                <div class="list-group">
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <input type="checkbox" class="form-check-input me-2" id="frites">
                            <label for="frites">Frites</label>
                        </div>
                        <span class="text-muted">+1000 FCFA</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <input type="checkbox" class="form-check-input me-2" id="boisson">
                            <label for="boisson">Coca Cola</label>
                        </div>
                        <span class="text-muted">+500 FCFA</span>
                    </div>
                </div>
            </div>

            <!-- Form Ajouter au Panier -->
            <form method="post" asp-controller="Panier" asp-action="Ajouter">
                <input type="hidden" name="type" value="burger">
                <input type="hidden" name="id" value="@Model.Id">
                
                <!-- Quantité -->
                <div class="mb-4">
                    <label class="form-label">Quantité</label>
                    <div class="input-group" style="max-width: 150px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decrementQuantity()">-</button>
                        <input type="number" id="quantite" name="quantite" class="form-control text-center" value="1" min="1">
                        <button class="btn btn-outline-secondary" type="button" onclick="incrementQuantity()">+</button>
                    </div>
                </div>

                <!-- Bouton Ajouter -->
                <button type="submit" class="btn btn-warning btn-lg w-100">
                    <i class="bi bi-cart-plus"></i> Ajouter au panier • @Model.Prix.ToString("N0") FCFA
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function incrementQuantity() {
        const input = document.getElementById('quantite');
        input.value = parseInt(input.value) + 1;
    }
    
    function decrementQuantity() {
        const input = document.getElementById('quantite');
        if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
        }
    }
</script>
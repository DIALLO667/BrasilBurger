@model BrasilBurger.ClientApp.Models.Commande

@{
    ViewData["Title"] = "Commande confirmée";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Success Message -->
            <div class="text-center mb-4">
                <div class="display-1 text-success mb-3">✅</div>
                <h2>Commande confirmée !</h2>
                <p class="text-muted">Votre commande a été enregistrée avec succès</p>
            </div>

            <!-- Détails Commande -->
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-3">Détails de la commande</h5>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>N° Commande</strong>
                        </div>
                        <div class="col-6 text-end">
                            #@Model.Id
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Date</strong>
                        </div>
                        <div class="col-6 text-end">
                            @Model.DateCommande.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Type</strong>
                        </div>
                        <div class="col-6 text-end">
                            @if (Model.TypeRecuperation == "sur_place")
                            {
                                <span class="badge bg-info">🍽️ Sur place</span>
                            }
                            else if (Model.TypeRecuperation == "emporter")
                            {
                                <span class="badge bg-warning text-dark">🥡 À emporter</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">🚚 Livraison</span>
                            }
                        </div>
                    </div>

                    @if (Model.TypeRecuperation == "livraison" && !string.IsNullOrEmpty(Model.AdresseLivraison))
                    {
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Adresse</strong>
                            </div>
                            <div class="col-6 text-end">
                                @Model.AdresseLivraison
                            </div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Statut</strong>
                        </div>
                        <div class="col-6 text-end">
                            <span class="badge bg-info">En cours</span>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-6">
                            <strong>Montant Total</strong>
                        </div>
                        <div class="col-6 text-end">
                            <h4 class="text-warning mb-0">@Model.MontantTotal.ToString("N0") FCFA</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Prochaines Étapes -->
            <div class="alert alert-warning mt-4">
                <h6><i class="bi bi-info-circle"></i> Prochaine étape : Paiement</h6>
                <p class="mb-0">Vous devez maintenant procéder au paiement pour valider votre commande.</p>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 mt-4">
                <a href="@Url.Action("Index", "Paiement", new { commandeId = Model.Id })" class="btn btn-warning flex-fill">
                    💳 Payer maintenant
                </a>
                <a href="@Url.Action("MesCommandes", "Commande")" class="btn btn-outline-secondary flex-fill">
                    📋 Mes commandes
                </a>
            </div>
        </div>
    </div>
</div>
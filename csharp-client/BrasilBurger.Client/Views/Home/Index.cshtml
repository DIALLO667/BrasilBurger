@model dynamic

@{
    ViewData["Title"] = "Accueil";
    Layout = "~/Views/Shared/_BrasilLayout.cshtml";
    
    // Récupérer les burgers depuis ViewBag
    var burgers = ViewBag.Burgers as List<BrasilBurger.ClientApp.Models.Burger> ?? new List<BrasilBurger.ClientApp.Models.Burger>();
    var menus = ViewBag.Menus as List<BrasilBurger.ClientApp.Models.Menu> ?? new List<BrasilBurger.ClientApp.Models.Menu>();
    var complements = ViewBag.Complements as List<BrasilBurger.ClientApp.Models.Complement> ?? new List<BrasilBurger.ClientApp.Models.Complement>();
    
    var allProducts = new List<dynamic>();
    allProducts.AddRange(burgers.Select(b => new { Type = "burger", Id = b.Id, Nom = b.Nom, Prix = b.Prix, Image = b.Image, Description = b.Description }));
    allProducts.AddRange(menus.Select(m => new { Type = "menu", Id = m.Id, Nom = m.Nom, Prix = m.PrixCalcule, Image = m.Image, Description = "Menu complet" }));
    allProducts.AddRange(complements.Select(c => new { Type = "complement", Id = c.Id, Nom = c.Nom, Prix = c.Prix, Image = c.Image, Description = c.Type }));
}

<style>
.right-sidebar {
    position: fixed;
    right: 32px;
    top: 32px;
    width: 300px;
    z-index: 100;
}

@@media (max-width: 1400px) {
    .right-sidebar {
        display: none;
    }
}
</style>

<!-- Hero Section -->
<section class="brasil-hero">
    <h1 class="brasil-hero-title">Les meilleurs burgers de Dakar</h1>
    <button class="brasil-hero-btn" onclick="scrollToProducts()">Commander maintenant</button>
</section>

<!-- Search Bar -->
<div class="brasil-search">
    <i class="bi bi-search brasil-search-icon"></i>
    <input type="text" id="searchInput" class="brasil-search-input" placeholder="Recherchez un produit ..." onkeyup="filterProducts()">
</div>

<!-- Categories -->
<div style="margin-bottom: 16px;">
    <strong style="font-size: 18px;">Catégories</strong>
</div>
<div class="brasil-categories">
    <button class="brasil-category-pill active" onclick="filterCategory('tous')">
        <span>👍</span>
        <span>Tous</span>
    </button>
    <button class="brasil-category-pill" onclick="filterCategory('burger')">
        <span>🍔</span>
        <span>Burgers</span>
    </button>
    <button class="brasil-category-pill" onclick="filterCategory('menu')">
        <span>📦</span>
        <span>Menus</span>
    </button>
    <button class="brasil-category-pill" onclick="filterCategory('complement')">
        <span>🥤</span>
        <span>Compléments</span>
    </button>
</div>

<!-- Section Header -->
<div class="brasil-section-header" id="products-section">
    <h2 class="brasil-section-title">Tous les produits</h2>
    <span class="brasil-section-count" id="productCount">@allProducts.Count produit(s)</span>
</div>

<!-- Sidebar "Mes commandes" (fixe à droite) -->

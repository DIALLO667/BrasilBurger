<!-- Products Grid -->
<div class="brasil-products-grid" id="productsGrid">
    @foreach (var product in allProducts)
    {
        var isPopular = product.Prix > 3000;
        
        <div class="brasil-product-card" data-type="@product.Type" data-name="@product.Nom.ToLower()">
            @if (isPopular)
            {
                <span class="brasil-product-badge">Populaire</span>
            }
            
            @if (!string.IsNullOrEmpty(product.Image))
            {
                <img src="@product.Image" class="brasil-product-image" alt="@product.Nom">
            }
            else
            {
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&h=300&fit=crop" class="brasil-product-image" alt="@product.Nom">
            }
            
            <div class="brasil-product-body">
                <h3 class="brasil-product-name">@product.Nom</h3>
                <div class="brasil-product-footer">
                    <span class="brasil-product-price">@product.Prix.ToString("N0") FCFA</span>
                    @if (product.Type == "burger")
                    {
                        <button class="brasil-btn-add" onclick="window.location.href='@Url.Action("Detail", "Burger", new { id = product.Id })'">+</button>
                    }
                    else if (product.Type == "menu")
                    {
                        <button class="brasil-btn-add" onclick="window.location.href='@Url.Action("Detail", "Menu", new { id = product.Id })'">+</button>
                    }
                    else
                    {
                        <form method="post" action="@Url.Action("Ajouter", "Panier")" style="display: inline;">
                            <input type="hidden" name="type" value="@product.Type">
                            <input type="hidden" name="id" value="@product.Id">
                            <input type="hidden" name="quantite" value="1">
                            <button type="submit" class="brasil-btn-add">+</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

<script>
let currentCategory = 'tous';

function scrollToProducts() {
    document.getElementById('products-section').scrollIntoView({ behavior: 'smooth' });
}

function filterCategory(category) {
    currentCategory = category;
    
    // Update active button
    document.querySelectorAll('.brasil-category-pill').forEach(btn => {
        btn.classList.remove('active');
    });
    event.target.closest('.brasil-category-pill').classList.add('active');
    
    // Filter products
    filterProducts();
}

function filterProducts() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.brasil-product-card');
    let visibleCount = 0;
    
    cards.forEach(card => {
        const type = card.dataset.type;
        const name = card.dataset.name;
        
        const matchesCategory = currentCategory === 'tous' || type === currentCategory;
        const matchesSearch = searchTerm === '' || name.includes(searchTerm);
        
        if (matchesCategory && matchesSearch) {
            card.style.display = 'block';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });
    
    // Update count
    document.getElementById('productCount').textContent = visibleCount + ' produit(s)';
}
</script>
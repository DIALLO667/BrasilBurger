@model IEnumerable<BrasilBurger.ClientApp.Models.Menu>

@{
    ViewData["Title"] = "Nos Menus";
}

<div class="container mt-4">
    <!-- Header Section -->
    <div class="text-center mb-4">
        <h1 class="display-4">🍔 Nos Menus</h1>
        <p class="lead text-muted">Menus complets : Burger + Boisson + Frites</p>
    </div>

    <!-- Filtres -->
    <div class="mb-4">
        <div class="btn-group" role="group">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-warning">
                Tous
            </a>
            <a href="@Url.Action("Index", "Burger")" class="btn btn-outline-warning">
                Burgers
            </a>
            <a href="@Url.Action("Index", "Menu")" class="btn btn-warning">
                Menus
            </a>
        </div>
    </div>

    <!-- Grille Menus -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var menu in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm hover-card">
                    <!-- Image Menu -->
                    @if (!string.IsNullOrEmpty(menu.Image))
                    {
                        <img src="@menu.Image" class="card-img-top" alt="@menu.Nom" style="height: 200px; object-fit: cover;">
                    }
                    else if (menu.Burger != null && !string.IsNullOrEmpty(menu.Burger.Image))
                    {
                        <img src="@menu.Burger.Image" class="card-img-top" alt="@menu.Nom" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-muted fs-1">🍔🥤🍟</span>
                        </div>
                    }

                    <!-- Badge "Menu Complet" -->
                    <div class="position-absolute top-0 end-0 m-2">
                        <span class="badge bg-success">Menu Complet</span>
                    </div>

                    <!-- Body -->
                    <div class="card-body">
                        <h5 class="card-title">@menu.Nom</h5>

                        <!-- Composition (3 mini-images/icônes) -->
                        <div class="d-flex gap-2 mb-3">
                            <!-- Burger -->
                            @if (menu.Burger != null)
                            {
                                <div class="text-center" style="width: 60px;">
                                    @if (!string.IsNullOrEmpty(menu.Burger.Image))
                                    {
                                        <img src="@menu.Burger.Image" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="Burger">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <span>🍔</span>
                                        </div>
                                    }
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Burger</small>
                                </div>
                            }

                            <!-- Séparateur -->
                            <div class="d-flex align-items-center">
                                <span class="text-warning fw-bold">+</span>
                            </div>

                            <!-- Boisson -->
                            @if (menu.Boisson != null)
                            {
                                <div class="text-center" style="width: 60px;">
                                    @if (!string.IsNullOrEmpty(menu.Boisson.Image))
                                    {
                                        <img src="@menu.Boisson.Image" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="Boisson">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <span>🥤</span>
                                        </div>
                                    }
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Boisson</small>
                                </div>
                            }

                            <!-- Séparateur -->
                            <div class="d-flex align-items-center">
                                <span class="text-warning fw-bold">+</span>
                            </div>

                            <!-- Frites -->
                            @if (menu.Frites != null)
                            {
                                <div class="text-center" style="width: 60px;">
                                    @if (!string.IsNullOrEmpty(menu.Frites.Image))
                                    {
                                        <img src="@menu.Frites.Image" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="Frites">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <span>🍟</span>
                                        </div>
                                    }
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Frites</small>
                                </div>
                            }
                        </div>

                        <!-- Prix avec badge "Auto" -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="h5 text-warning mb-0">@menu.PrixCalcule.ToString("N0") FCFA</span>
                                <span class="badge bg-info text-dark ms-2" style="font-size: 0.7rem;">Auto</span>
                            </div>
                            <a href="@Url.Action("Detail", "Menu", new { id = menu.Id })" 
                               class="btn btn-warning btn-sm">
                                <i class="bi bi-eye"></i> Détails
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">Aucun menu disponible pour le moment.</p>
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out;
    }
    .hover-card:hover {
        transform: translateY(-5px);
    }
</style>
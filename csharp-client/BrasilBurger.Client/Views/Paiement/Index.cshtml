@{
    ViewData["Title"] = "Paiement";
    Layout = "~/Views/Shared/_BrasilLayout.cshtml";
    
    var commande = ViewBag.Commande as BrasilBurger.ClientApp.Models.Commande;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">💳 Paiement</h2>
                        <p class="text-muted">Commande #@commande.Id</p>
                    </div>

                    <!-- Montant -->
                    <div class="alert alert-warning text-center mb-4">
                        <h3 class="mb-0">@commande.MontantTotal.ToString("N0") FCFA</h3>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <!-- Formulaire -->
                    <form method="post" asp-action="Traiter">
                        <input type="hidden" name="commandeId" value="@commande.Id">

                        <!-- Choix Méthode -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Choisir votre mode de paiement</label>

                            <div class="form-check mb-3 p-3 border rounded">
                                <input class="form-check-input" type="radio" name="methode" 
                                       id="wave" value="wave" required>
                                <label class="form-check-label w-100" for="wave">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3" style="font-size: 2rem;">💛</div>
                                        <div>
                                            <strong>Wave</strong>
                                            <p class="text-muted small mb-0">Paiement via Wave Money</p>
                                        </div>
                                    </div>
                                </label>
                            </div>

                            <div class="form-check p-3 border rounded">
                                <input class="form-check-input" type="radio" name="methode" 
                                       id="om" value="orange_money" required>
                                <label class="form-check-label w-100" for="om">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3" style="font-size: 2rem;">🧡</div>
                                        <div>
                                            <strong>Orange Money</strong>
                                            <p class="text-muted small mb-0">Paiement via Orange Money</p>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Numéro de téléphone -->
                        <div class="mb-4">
                            <label for="numeroTelephone" class="form-label">Numéro de téléphone *</label>
                            <input type="tel" class="form-control" id="numeroTelephone" 
                                   name="numeroTelephone" placeholder="+221 77 123 45 67" required>
                            <small class="text-muted">Le numéro associé à votre compte mobile money</small>
                        </div>

                        <!-- Info Sécurité -->
                        <div class="alert alert-info small">
                            <i class="bi bi-shield-check"></i> 
                            Vous recevrez une demande de confirmation sur votre téléphone
                        </div>

                        <!-- Bouton Payer -->
                        <button type="submit" class="btn btn-warning btn-lg w-100">
                            Payer @commande.MontantTotal.ToString("N0") FCFA
                        </button>

                        <!-- Bouton Annuler -->
                        <a href="@Url.Action("Confirmation", "Commande", new { id = commande.Id })" 
                           class="btn btn-outline-secondary w-100 mt-2">
                            Annuler
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@model List<BrasilBurger.ClientApp.Models.PanierItem>

@{
    ViewData["Title"] = "Mon Panier";
    Layout = "~/Views/Shared/_BrasilLayout.cshtml";
}

<style>
.panier-container {
    display: flex;
    gap: 32px;
}

.panier-items {
    flex: 1;
}

.panier-item {
    background: white;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
}

.panier-item-img {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
}

.panier-item-info {
    flex: 1;
}

.panier-item-name {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
}

.panier-item-price {
    color: #6B7280;
    font-size: 14px;
}

.panier-qty {
    display: flex;
    align-items: center;
    gap: 12px;
}

.panier-qty-btn {
    width: 32px;
    height: 32px;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 600;
}

.panier-qty-btn:hover {
    background: #F9FAFB;
}

.panier-qty-value {
    font-weight: 600;
    min-width: 30px;
    text-align: center;
}

.panier-item-total {
    font-size: 20px;
    font-weight: 700;
    color: #F59E0B;
}

.panier-item-delete {
    color: #EF5350;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    padding: 8px;
}

.panier-summary {
    width: 350px;
    position: sticky;
    top: 32px;
}

.summary-card {
    background: white;
    border-radius: 16px;
    padding: 24px;
}

.summary-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 20px;
}

.summary-line {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    color: #6B7280;
}

.summary-total {
    font-size: 28px;
    font-weight: 700;
    color: #F59E0B;
}

.btn-validate {
    width: 100%;
    background: #FCD34D;
    color: black;
    border: none;
    padding: 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-validate:hover {
    background: #F59E0B;
}
</style>

<h1 style="font-size: 32px; font-weight: 700; margin-bottom: 32px;">Mon Panier</h1>

@if (!Model.Any())
{
    <div style="text-align: center; padding: 80px 20px;">
        <div style="font-size: 64px; margin-bottom: 16px;">🛒</div>
        <h3 style="color: #6B7280; margin-bottom: 8px;">Votre panier est vide</h3>
        <p style="color: #9CA3AF;">Ajoutez des produits pour commencer !</p>
        <a href="@Url.Action("Index", "Home")" class="brasil-hero-btn" style="margin-top: 24px;">
            Découvrir les produits
        </a>
    </div>
}
else
{
    <div class="panier-container">
        <!-- Items -->
        <div class="panier-items">
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <div class="panier-item">
                    <img src="@(item.Image ?? "https://via.placeholder.com/80")" class="panier-item-img" alt="@item.Nom">
                    
                    <div class="panier-item-info">
                        <div class="panier-item-name">@item.Nom</div>
                        <div class="panier-item-price">@item.Prix.ToString("N0") FCFA</div>
                    </div>

                    <div class="panier-qty">
                        <form method="post" asp-action="UpdateQuantite" style="display: inline;">
                            <input type="hidden" name="index" value="@i">
                            <button type="submit" name="quantite" value="@(item.Quantite - 1)" class="panier-qty-btn">−</button>
                        </form>
                        <span class="panier-qty-value">@item.Quantite</span>
                        <form method="post" asp-action="UpdateQuantite" style="display: inline;">
                            <input type="hidden" name="index" value="@i">
                            <button type="submit" name="quantite" value="@(item.Quantite + 1)" class="panier-qty-btn">+</button>
                        </form>
                    </div>

                    <div class="panier-item-total">@item.Total.ToString("N0") FCFA</div>

                    <form method="post" asp-action="Retirer" style="display: inline;">
                        <input type="hidden" name="index" value="@i">
                        <button type="submit" class="panier-item-delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            }
        </div>

        <!-- Summary -->
        <div class="panier-summary">
            <div class="summary-card">
                <h3 class="summary-title">Résumé</h3>
                
                <div class="summary-line">
                    <span>Sous-total</span>
                    <span class="summary-total">@ViewBag.Total.ToString("N0") FCFA</span>
                </div>

                <button class="btn-validate" onclick="window.location.href='@Url.Action("Checkout", "Commande")'">
                    Valider la commande
                </button>
            </div>
        </div>
    </div>
}
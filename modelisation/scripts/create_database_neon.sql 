DROP TABLE IF EXISTS Paiement CASCADE;
DROP TABLE IF EXISTS LigneCommande CASCADE;
DROP TABLE IF EXISTS Commande CASCADE;
DROP TABLE IF EXISTS Menu CASCADE;
DROP TABLE IF EXISTS Complement CASCADE;
DROP TABLE IF EXISTS Burger CASCADE;
DROP TABLE IF EXISTS Livreur CASCADE;
DROP TABLE IF EXISTS Zone CASCADE;
DROP TABLE IF EXISTS Client CASCADE;

CREATE TABLE Client (
    id SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    telephone VARCHAR(20) UNIQUE NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    mot_de_passe VARCHAR(255) NOT NULL,
    adresse TEXT,
    date_creation TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Burger (
    id SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prix DECIMAL(10,2) NOT NULL,
    image VARCHAR(255),
    description TEXT,
    archive BOOLEAN DEFAULT FALSE,
    date_creation TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Complement (
    id SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    type VARCHAR(20) NOT NULL CHECK (type IN ('boisson', 'frites')),
    prix DECIMAL(10,2) NOT NULL,
    image VARCHAR(255),
    archive BOOLEAN DEFAULT FALSE,
    date_creation TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE Menu (
    id SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    image VARCHAR(255),
    burger_id INT NOT NULL,
    boisson_id INT NOT NULL,
    frites_id INT NOT NULL,
    prix_calcule DECIMAL(10,2) NOT NULL,
    archive BOOLEAN DEFAULT FALSE,
    date_creation TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (burger_id) REFERENCES Burger(id),
    FOREIGN KEY (boisson_id) REFERENCES Complement(id),
    FOREIGN KEY (frites_id) REFERENCES Complement(id)
);

CREATE TABLE Zone (
    id SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    quartiers TEXT,
    prix_livraison DECIMAL(10,2) NOT NULL
);

CREATE TABLE Livreur (
    id SERIAL PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    telephone VARCHAR(20) UNIQUE NOT NULL,
    zone_id INT,
    FOREIGN KEY (zone_id) REFERENCES Zone(id)
);

CREATE TABLE Commande (
    id SERIAL PRIMARY KEY,
    client_id INT NOT NULL,
    date_commande TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    montant_total DECIMAL(10,2) NOT NULL,
    type_recuperation VARCHAR(20) NOT NULL CHECK (type_recuperation IN ('sur_place', 'emporter', 'livraison')),
    etat VARCHAR(20) DEFAULT 'en_cours' CHECK (etat IN ('en_cours', 'validee', 'terminee', 'annulee')),
    zone_id INT,
    livreur_id INT,
    FOREIGN KEY (client_id) REFERENCES Client(id),
    FOREIGN KEY (zone_id) REFERENCES Zone(id),
    FOREIGN KEY (livreur_id) REFERENCES Livreur(id)
);

CREATE TABLE LigneCommande (
    id SERIAL PRIMARY KEY,
    commande_id INT NOT NULL,
    produit_type VARCHAR(20) NOT NULL CHECK (produit_type IN ('burger', 'menu')),
    produit_id INT NOT NULL,
    quantite INT DEFAULT 1,
    prix_unitaire DECIMAL(10,2) NOT NULL,
    complements_ids TEXT,
    FOREIGN KEY (commande_id) REFERENCES Commande(id) ON DELETE CASCADE
);

CREATE TABLE Paiement (
    id SERIAL PRIMARY KEY,
    commande_id INT UNIQUE NOT NULL,
    date_paiement TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    montant DECIMAL(10,2) NOT NULL,
    methode VARCHAR(20) NOT NULL CHECK (methode IN ('wave', 'om')),
    reference_transaction VARCHAR(100),
    FOREIGN KEY (commande_id) REFERENCES Commande(id)
);

CREATE INDEX idx_commande_client ON Commande(client_id);
CREATE INDEX idx_commande_date ON Commande(date_commande);
CREATE INDEX idx_commande_etat ON Commande(etat);
CREATE INDEX idx_ligne_commande ON LigneCommande(commande_id);
CREATE INDEX idx_paiement_commande ON Paiement(commande_id);


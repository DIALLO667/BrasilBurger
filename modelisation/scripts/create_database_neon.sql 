SELECT COUNT(*) AS total_zones FROM Zone;
SELECT COUNT(*) AS total_livreurs FROM Livreur;
SELECT COUNT(*) AS total_burgers FROM Burger;
SELECT COUNT(*) AS total_complements FROM Complement;
SELECT COUNT(*) AS total_menus FROM Menu;
SELECT COUNT(*) AS total_clients FROM Client;
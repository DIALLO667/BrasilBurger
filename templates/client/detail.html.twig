{% extends 'base.html.twig' %}

{% block title %}{{ client.getNomComplet() }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1>{{ client.getNomComplet() }}</h1>
                <a href="{{ path('client_recherche') }}" class="btn btn-secondary">← Retour</a>
            </div>
        </div>
    </div>

    <!-- Stats Client -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body">
                    <h6>Total dépensé</h6>
                    <h2>{{ client.totalDepense|number_format(0, ',', ' ') }} FCFA</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body">
                    <h6>Nombre de commandes</h6>
                    <h2>{{ client.nombreCommandes }}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h6>Informations contact</h6>
                    <p class="mb-1"><strong>Email :</strong> {{ client.email }}</p>
                    <p class="mb-1"><strong>Téléphone :</strong> {{ client.telephone }}</p>
                    {% if client.derniereCommande %}
                    <p class="mb-0"><strong>Dernière commande :</strong> {{ client.derniereCommande|date('d/m/Y H:i') }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Historique Commandes -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Historique des commandes</h5>
        </div>
        <div class="card-body">
            {% if commandes|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Date</th>
                            <th>Montant</th>
                            <th>Type</th>
                            <th>État</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td><strong>#{{ commande.id }}</strong></td>
                            <td>{{ commande.date_commande|date('d/m/Y H:i') }}</td>
                            <td>{{ commande.montant_total|number_format(0, ',', ' ') }} FCFA</td>
                            <td>
                                {% if commande.type_recuperation == 'livraison' %}
                                    <span class="badge bg-warning">🚚 Livraison</span>
                                {% elseif commande.type_recuperation == 'emporter' %}
                                    <span class="badge bg-info">🥡 À emporter</span>
                                {% else %}
                                    <span class="badge bg-secondary">🍽️ Sur place</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if commande.etat == 'en_cours' %}
                                    <span class="badge bg-primary">En cours</span>
                                {% elseif commande.etat == 'terminee' %}
                                    <span class="badge bg-success">Terminée</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ commande.etat }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('commande_detail', {id: commande.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <p class="text-muted">Aucune commande</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Commande #{{ commande.id }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Commande #{{ commande.id }}</h1>
                    <p class="text-muted mb-0">{{ commande.dateCommande|date('d/m/Y à H:i') }}</p>
                </div>
                <a href="{{ path('commande_index') }}" class="btn btn-secondary">← Retour</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Client -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">👤 Client</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Nom :</strong> {{ commande.client.prenom }} {{ commande.client.nom }}</p>
                            <p><strong>Email :</strong> {{ commande.client.email }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Téléphone :</strong> {{ commande.client.telephone }}</p>
                        </div>
                    </div>
                    
                    {% if commande.typeRecuperation == 'livraison' and commande.adresseLivraison %}
                    <hr>
                    <p class="mb-0"><strong>📍 Adresse :</strong><br>{{ commande.adresseLivraison }}</p>
                    {% if commande.zone %}
                    <p class="mt-2"><strong>Zone :</strong> {{ commande.zone.nom }} ({{ commande.zone.prix_livraison }} FCFA)</p>
                    {% endif %}
                    {% if commande.livreur %}
                    <p><strong>Livreur :</strong> {{ commande.livreur.prenom }} {{ commande.livreur.nom }} ({{ commande.livreur.telephone }})</p>
                    {% endif %}
                    {% endif %}
                </div>
            </div>

            <!-- Produits -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">🍔 Produits</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Type</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">Prix unit.</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in commande.lignes %}
                            <tr>
                                <td>{{ ligne.produit_nom }}</td>
                                <td>
                                    {% if ligne.type_produit == 'Burger' %}
                                        <span class="badge bg-warning">Burger</span>
                                    {% else %}
                                        <span class="badge bg-info">Menu</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">{{ ligne.quantite }}</td>
                                <td class="text-end">{{ ligne.prix_unitaire|number_format(0, ',', ' ') }} FCFA</td>
                                <td class="text-end"><strong>{{ (ligne.quantite * ligne.prix_unitaire)|number_format(0, ',', ' ') }} FCFA</strong></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <td colspan="4" class="text-end"><strong>TOTAL</strong></td>
                                <td class="text-end"><h5 class="mb-0">{{ commande.montantTotal|number_format(0, ',', ' ') }} FCFA</h5></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Paiement -->
            {% if commande.paiement %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">💳 Paiement</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <p><strong>Méthode :</strong> 
                                {% if commande.paiement.methode == 'wave' %}
                                    💛 Wave
                                {% elseif commande.paiement.methode == 'orange_money' %}
                                    🧡 Orange Money
                                {% else %}
                                    {{ commande.paiement.methode }}
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Montant :</strong> {{ commande.paiement.montant|number_format(0, ',', ' ') }} FCFA</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Date :</strong> {{ commande.paiement.date_paiement|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>
                    {% if commande.paiement.reference_transaction %}
                    <p class="mb-0"><small class="text-muted">Réf : {{ commande.paiement.reference_transaction }}</small></p>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Colonne Droite -->
        <div class="col-md-4">
            <!-- Résumé -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">📊 Résumé</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span>Type :</span>
                        <strong>
                            {% if commande.typeRecuperation == 'livraison' %}
                                🚚 Livraison
                            {% elseif commande.typeRecuperation == 'emporter' %}
                                🥡 À emporter
                            {% else %}
                                🍽️ Sur place
                            {% endif %}
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>État :</span>
                        <span>
                            {% if commande.etat == 'en_cours' %}
                                <span class="badge bg-primary">En cours</span>
                            {% elseif commande.etat == 'terminee' %}
                                <span class="badge bg-success">Terminée</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ commande.etat }}</span>
                            {% endif %}
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Montant :</span>
                        <strong class="text-primary">{{ commande.montantTotal|number_format(0, ',', ' ') }} FCFA</strong>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">⚡ Actions</h5>
                </div>
                <div class="card-body">
                    {% if commande.etat == 'en_cours' %}
                        <form method="post" action="{{ path('commande_terminer', {id: commande.id}) }}">
                            <button type="submit" class="btn btn-success w-100" onclick="return confirm('Marquer cette commande comme terminée ?')">
                                ✓ Terminer la commande
                            </button>
                        </form>
                    {% elseif commande.etat == 'terminee' %}
                        <div class="alert alert-success mb-0">
                            ✓ Commande terminée
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

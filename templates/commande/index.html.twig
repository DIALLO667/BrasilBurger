{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>Gestion des Commandes</h1>
            <p class="text-muted">{{ commandes|length }} commande(s)</p>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">État</label>
                    <select name="etat" class="form-select">
                        <option value="">Tous</option>
                        <option value="en_cours" {{ filtres.etat == 'en_cours' ? 'selected' : '' }}>En cours</option>
                        <option value="terminee" {{ filtres.etat == 'terminee' ? 'selected' : '' }}>Terminée</option>
                        <option value="annulee" {{ filtres.etat == 'annulee' ? 'selected' : '' }}>Annulée</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Type</label>
                    <select name="type" class="form-select">
                        <option value="">Tous</option>
                        <option value="sur_place" {{ filtres.type == 'sur_place' ? 'selected' : '' }}>Sur place</option>
                        <option value="emporter" {{ filtres.type == 'emporter' ? 'selected' : '' }}>À emporter</option>
                        <option value="livraison" {{ filtres.type == 'livraison' ? 'selected' : '' }}>Livraison</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Client (nom)</label>
                    <input type="text" name="clientNom" class="form-control" value="{{ filtres.clientNom }}" placeholder="Rechercher...">
                </div>

                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">Filtrer</button>
                </div>

                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <a href="{{ path('commande_index') }}" class="btn btn-secondary w-100">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau Commandes -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Montant</th>
                            <th>Type</th>
                            <th>État</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                        <tr>
                            <td><strong>#{{ commande.id }}</strong></td>
                            <td>{{ commande.clientNom }}</td>
                            <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                            <td><strong>{{ commande.montantTotal|number_format(0, ',', ' ') }} FCFA</strong></td>
                            <td>
                                {% if commande.typeRecuperation == 'livraison' %}
                                    <span class="badge bg-warning">🚚 Livraison</span>
                                {% elseif commande.typeRecuperation == 'emporter' %}
                                    <span class="badge bg-info">🥡 À emporter</span>
                                {% else %}
                                    <span class="badge bg-secondary">🍽️ Sur place</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if commande.etat == 'en_cours' %}
                                    <span class="badge bg-primary">En cours</span>
                                {% elseif commande.etat == 'terminee' %}
                                    <span class="badge bg-success">Terminée</span>
                                {% elseif commande.etat == 'annulee' %}
                                    <span class="badge bg-danger">Annulée</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ commande.etat }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('commande_detail', {id: commande.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted">Aucune commande trouvée</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

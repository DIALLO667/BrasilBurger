{% extends 'base.html.twig' %}

{% block title %}Compléments{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Gestion des Compléments</h1>
                    <p class="text-muted">{{ complements|length }} complément(s)</p>
                </div>
                <a href="{{ path('complement_create') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i> Nouveau complément
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        {% for complement in complements %}
        <div class="col-md-4 mb-4">
            <div class="card">
                {% if complement.image %}
                <img src="{{ complement.image }}" class="card-img-top" alt="{{ complement.nom }}" style="height: 200px; object-fit: cover;">
                {% else %}
                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="fas fa-glass-cheers fa-3x text-white"></i>
                </div>
                {% endif %}
                <div class="card-body">
                    <h5 class="card-title">{{ complement.nom }}</h5>
                    <p class="card-text">
                        <strong class="text-primary">{{ complement.prix|number_format(0, ',', ' ') }} FCFA</strong>
                    </p>
                    
                    <div class="d-flex gap-2">
                        <a href="{{ path('complement_edit', {id: complement.id}) }}" class="btn btn-sm btn-warning flex-fill">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <form method="post" action="{{ path('complement_archive', {id: complement.id}) }}" class="flex-fill">
                            <button type="submit" class="btn btn-sm btn-danger w-100">
                                <i class="fas fa-archive"></i> Archiver
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-info">
                Aucun complément. <a href="{{ path('complement_create') }}">Créer le premier complément</a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

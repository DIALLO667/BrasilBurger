{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display mb-2">Tableau de Bord</h1>
            <p class="text-muted" style="font-family: var(--font-sans);">
                Bienvenue <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong> • 
                Statistiques du {{ "now"|date("d/m/Y") }}
            </p>
        </div>
    </div>

    <!-- Statistiques Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);">
                <h6>Commandes en cours</h6>
                <h2>{{ stats.commandesEnCours }}</h2>
                <small>Aujourd'hui</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);">
                <h6>Commandes validées</h6>
                <h2>{{ stats.commandesValidees }}</h2>
                <small>Aujourd'hui</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #FF6B35 0%, #E55A2A 100%);">
                <h6>Recettes journalières</h6>
                <h2 style="font-size: 1.75rem;">{{ stats.recettesJournalieres|number_format(0, ',', ' ') }} <small style="font-size: 1rem;">FCFA</small></h2>
                <small>Commandes payées</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #E53935 0%, #C62828 100%);">
                <h6>Commandes annulées</h6>
                <h2>{{ stats.commandesAnnulees }}</h2>
                <small>Aujourd'hui</small>
            </div>
        </div>
    </div>

    <!-- Top Produits -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0" style="font-family: var(--font-display); color: var(--primary);">
                        🍔 Top Burgers du jour
                    </h5>
                </div>
                <div class="card-body">
                    {% if stats.topBurgers|length > 0 %}
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Burger</th>
                                    <th class="text-end">Quantité</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for burger in stats.topBurgers %}
                                <tr>
                                    <td style="font-weight: 500;">{{ burger.nom }}</td>
                                    <td class="text-end">
                                        <span class="badge" style="background-color: var(--primary);">{{ burger.quantite }}</span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted text-center py-4">Aucun burger vendu aujourd'hui</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0" style="font-family: var(--font-display); color: var(--accent);">
                        🎯 Top Menus du jour
                    </h5>
                </div>
                <div class="card-body">
                    {% if stats.topMenus|length > 0 %}
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Menu</th>
                                    <th class="text-end">Quantité</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for menu in stats.topMenus %}
                                <tr>
                                    <td style="font-weight: 500;">{{ menu.nom }}</td>
                                    <td class="text-end">
                                        <span class="badge" style="background-color: var(--accent); color: #000;">{{ menu.quantite }}</span>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-muted text-center py-4">Aucun menu vendu aujourd'hui</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

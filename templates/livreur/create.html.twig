{% extends 'base.html.twig' %}

{% block title %}Nouveau livreur{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1>Nouveau livreur</h1>
                <a href="{{ path('livreur_index') }}" class="btn btn-secondary">← Retour</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label for="nom" class="form-label">Nom *</label>
                            <input type="text" class="form-control" id="nom" name="nom" required>
                        </div>

                        <div class="mb-3">
                            <label for="prenom" class="form-label">Prénom *</label>
                            <input type="text" class="form-control" id="prenom" name="prenom" required>
                        </div>

                        <div class="mb-3">
                            <label for="telephone" class="form-label">Téléphone *</label>
                            <input type="tel" class="form-control" id="telephone" name="telephone" placeholder="+221 77 123 45 67" required>
                        </div>

                        <div class="mb-3">
                            <label for="zone_id" class="form-label">Zone assignée</label>
                            <select class="form-select" id="zone_id" name="zone_id">
                                <option value="">Aucune zone</option>
                                {% for zone in zones %}
                                <option value="{{ zone.id }}">{{ zone.nom }} ({{ zone.prix_livraison }} FCFA)</option>
                                {% endfor %}
                            </select>
                            <small class="text-muted">Optionnel : vous pouvez assigner une zone plus tard</small>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i> Créer le livreur
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

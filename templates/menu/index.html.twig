{% extends 'base.html.twig' %}

{% block title %}Menus{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Gestion des Menus</h1>
                    <p class="text-muted">{{ menus|length }} menu(s)</p>
                </div>
                <a href="{{ path('menu_create') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i> Nouveau menu
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        {% for menu in menus %}
        <div class="col-md-4 mb-4">
            <div class="card">
                {% if menu.image %}
                <img src="{{ menu.image }}" class="card-img-top" alt="{{ menu.nom }}" style="height: 200px; object-fit: cover;">
                {% else %}
                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                    <i class="fas fa-utensils fa-3x text-white"></i>
                </div>
                {% endif %}
                <div class="card-body">
                    <h5 class="card-title">{{ menu.nom }}</h5>
                    
                    <div class="d-flex gap-2">
                        <a href="{{ path('menu_edit', {id: menu.id}) }}" class="btn btn-sm btn-warning flex-fill">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <form method="post" action="{{ path('menu_archive', {id: menu.id}) }}" class="flex-fill">
                            <button type="submit" class="btn btn-sm btn-danger w-100">
                                <i class="fas fa-archive"></i> Archiver
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-info">
                Aucun menu. <a href="{{ path('menu_create') }}">Créer le premier menu</a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Zones{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Gestion des Zones</h1>
                    <p class="text-muted">{{ zones|length }} zone(s)</p>
                </div>
                <a href="{{ path('zone_create') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i> Nouvelle zone
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        {% for zone in zones %}
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="mb-1">{{ zone.nom }}</h5>
                            <p class="text-muted mb-0">
                                <i class="fas fa-money-bill me-1"></i> 
                                {{ zone.prix_livraison|number_format(0, ',', ' ') }} FCFA
                            </p>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="{{ path('zone_edit', {id: zone.id}) }}">
                                        <i class="fas fa-edit me-2"></i> Modifier
                                    </a>
                                </li>
                                <li>
                                    <form method="post" action="{{ path('zone_delete', {id: zone.id}) }}">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-trash me-2"></i> Supprimer
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <hr>

                    <div>
                        <strong>Quartiers couverts :</strong>
                        <div class="mt-2">
                            {% set quartiers = zone.quartiers|json_decode %}
                            {% for quartier in quartiers %}
                                <span class="badge bg-info me-1 mb-1">{{ quartier }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-info">
                Aucune zone enregistrée. <a href="{{ path('zone_create') }}">Créer la première zone</a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
